<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Qipai</RootNamespace>
    <AssemblyName>qipai-server</AssemblyName>
    <PublishTrimmed>false</PublishTrimmed>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="wwwroot/**" />
    <Content Include="../rules/manifest.json" Link="rules/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../rules/vectors.json" Link="rules/vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../themes/themes.json" Link="themes/themes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
