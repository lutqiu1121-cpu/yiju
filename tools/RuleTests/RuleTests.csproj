<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Qipai.Tests</RootNamespace>
    <AssemblyName>qipai-rule-tests</AssemblyName>
  </PropertyGroup>
  <!-- 直接复用服务端规则源码，不引用 ASP.NET / WebSocket，可单独编译运行 -->
  <ItemGroup>
    <Compile Include="../../server/Rules/**/*.cs" />
    <!-- Program.cs 的 using Qipai 用到纯工具类 Json.cs；它只依赖标准库，不引 ASP.NET -->
    <Compile Include="../../server/Core/Json.cs" />
  </ItemGroup>
</Project>
