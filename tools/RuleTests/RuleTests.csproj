<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Qipai.Tests</RootNamespace>
    <AssemblyName>qipai-rule-tests</AssemblyName>
  </PropertyGroup>
  <!-- 直接复用服务端规则源码，不引用 ASP.NET / WebSocket，可单独编译运行 -->
  <ItemGroup>
    <Compile Include="../../server/Rules/**/*.cs" />
    <!-- 规则源码依赖的纯工具类（JSON 帧解析），仅 System.Text.Json，不引入 ASP.NET / WebSocket -->
    <Compile Include="../../server/Core/Json.cs" />
  </ItemGroup>
</Project>
